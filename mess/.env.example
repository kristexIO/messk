# HTTP server
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
DB_PATH=messenger.db
UPLOAD_DIR=uploads

# File uploads
MAX_UPLOAD_MB=80
ALLOWED_UPLOAD_MIME_TYPES=application/octet-stream
FILE_TOKEN_TTL_MINUTES=60

# Auth/session hardening
SESSION_TOKEN_TTL_MINUTES=1440
RATE_LIMIT_PER_MINUTE=200

# Optional Redis pub/sub for multi-instance routing
REDIS_ADDR=127.0.0.1:6379

# Optional relay/bootstrap registry. Leave RELAY_ANNOUNCE_TOKEN empty to allow
# relay announcements only from loopback during local development.
RELAY_ANNOUNCE_TOKEN=
RELAY_MAX_TTL_MINUTES=1440
RELAY_MAX_NODES=256
RELAY_MIN_REVOCATION_EPOCH=0
RELAY_REVOKED_NODES=
RELAY_REVOKED_PUBLIC_KEYS=

# Optional operator settings for `go run ./tools/relay-announce`.
# Keep RELAY_SIGNING_KEY_FILE outside the repository.
RELAY_ANNOUNCER_ENABLED=false
RELAY_ANNOUNCE_TARGET=http://127.0.0.1:8080
RELAY_NODE_ID=relay-local
RELAY_SIGNING_KEY_FILE=
RELAY_ENDPOINT_ORIGINS=http://127.0.0.1:8080
RELAY_TRANSPORTS=central_ws,fallback_wss
RELAY_REGION_HINT=
RELAY_CAPACITY_CLASS=small
RELAY_TTL=12h
RELAY_REFRESH_INTERVAL=0

# Keep disabled in production unless a reviewed allowlist/policy is in place.
ENABLE_METADATA_PROXY=false
